---
// Formulário que grava no Strapi (coleção "Mensagem"). A equipe lê e responde pelo painel.
import { formEndpoint } from '../lib/strapi';

type Opcao = { valor: string; rotulo: string };
interface Props {
  id: string;
  tipo?: string;                 // tipo fixo, ou...
  opcoes?: Opcao[];              // ...o visitante escolhe
  rotuloOpcoes?: string;
  pedirTelefone?: boolean;
  pedirCidade?: boolean;
  emailObrigatorio?: boolean;
  rotuloMensagem?: string;
  mensagemObrigatoria?: boolean;
  botao: string;
  sucesso: string;
  escuro?: boolean;
}
const {
  id, tipo, opcoes, rotuloOpcoes = 'Assunto', pedirTelefone = false, pedirCidade = false, emailObrigatorio = true,
  rotuloMensagem = 'Mensagem', mensagemObrigatoria = true, botao, sucesso, escuro = false,
} = Astro.props;
---

<form class:list={['form', { escuro }]} id={id} data-form action={formEndpoint} method="post" novalidate>
  {tipo && <input type="hidden" name="tipo" value={tipo} />}
  {opcoes && (
    <label class="campo campo--largo">
      <span>{rotuloOpcoes}</span>
      <select name="tipo" required>
        {opcoes.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
      </select>
    </label>
  )}
  <label class="campo">
    <span>Seu nome</span>
    <input name="nome" autocomplete="name" required maxlength="120" />
  </label>
  <label class="campo">
    <span>E-mail{!emailObrigatorio && <em> (opcional)</em>}</span>
    <input name="email" type="email" autocomplete="email" required={emailObrigatorio} />
  </label>
  {pedirTelefone && (
    <label class="campo">
      <span>WhatsApp ou telefone <em>(opcional)</em></span>
      <input name="telefone" type="tel" autocomplete="tel" maxlength="40" />
    </label>
  )}
  {pedirCidade && (
    <label class="campo">
      <span>Cidade <em>(opcional)</em></span>
      <input name="cidade" autocomplete="address-level2" maxlength="120" />
    </label>
  )}
  <label class="campo campo--largo">
    <span>{rotuloMensagem}{!mensagemObrigatoria && <em> (opcional)</em>}</span>
    <textarea name="mensagem" rows="5" maxlength="5000" required={mensagemObrigatoria}></textarea>
  </label>
  <!-- armadilha para robôs: pessoas não veem este campo -->
  <label class="armadilha" aria-hidden="true">Site<input name="site" tabindex="-1" autocomplete="off" /></label>

  <div class="form__rodape campo--largo">
    <button class="btn btn--carmim" type="submit">{botao} <span class="seta" aria-hidden="true">→</span></button>
    <p class="form__status" role="status" aria-live="polite"></p>
  </div>
  <div class="form__sucesso" hidden tabindex="-1">
    <svg viewBox="0 0 20 28" aria-hidden="true"><path d="M10 1C12 8 18 11 18 18a8 8 0 0 1-16 0c0-4 2-6 4-8 0 3 1 5 3 6-1-5 0-10 1-15Z" /></svg>
    <p>{sucesso}</p>
  </div>
</form>

<style>
  .form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 24px; }
  .campo { display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem; font-weight: 500; }
  .campo em { font-style: normal; font-weight: 400; color: var(--marrom-suave); }
  .campo--largo { grid-column: 1 / -1; }
  .campo input, .campo textarea, .campo select {
    font: 400 1rem/1.5 var(--f-corpo); color: var(--marrom); background: rgba(255, 252, 245, 0.7);
    border: 1px solid var(--linha-forte); border-radius: 8px; padding: 0.85em 1em; width: 100%;
    transition: border-color 300ms var(--ease-saida), background 300ms var(--ease-saida), box-shadow 300ms var(--ease-saida);
  }
  .campo textarea { resize: vertical; min-height: 140px; }
  .campo input:focus, .campo textarea:focus, .campo select:focus { outline: none; border-color: var(--carmim); background: #fffcf5; box-shadow: 0 0 0 3px rgba(141, 28, 32, 0.12); }
  .campo [aria-invalid='true'] { border-color: var(--carmim); }
  .armadilha { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__rodape { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 6px; }
  .form__status { font-size: 0.92rem; color: var(--carmim); }
  .form__sucesso { grid-column: 1 / -1; display: flex; gap: 16px; align-items: flex-start; padding: 28px; border-radius: 10px; background: var(--creme-2); }
  .form__sucesso[hidden] { display: none; }
  .form__sucesso svg { width: 20px; flex: none; fill: none; stroke: var(--carmim); stroke-width: 1.4; margin-top: 4px; }
  .form__sucesso p { font-family: var(--f-display); font-size: 1.4rem; line-height: 1.4; }
  .form.enviado > :not(.form__sucesso) { display: none; }
  .form button[disabled] { opacity: 0.6; cursor: progress; }

  .form.escuro .campo em { color: rgba(244, 237, 225, 0.65); }
  .form.escuro .campo input, .form.escuro .campo textarea, .form.escuro .campo select { background: rgba(244, 237, 225, 0.06); color: var(--creme); border-color: rgba(244, 237, 225, 0.3); }
  .form.escuro .campo input:focus, .form.escuro .campo textarea:focus { background: rgba(244, 237, 225, 0.1); border-color: var(--ouro-claro); box-shadow: 0 0 0 3px rgba(216, 189, 133, 0.18); }
  .form.escuro .form__status { color: var(--ouro-luz); }
  .form.escuro .form__sucesso { background: rgba(244, 237, 225, 0.08); }
  .form.escuro .form__sucesso svg { stroke: var(--ouro-claro); }

  @media (max-width: 640px) { .form { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

      const invalido = [...form.querySelectorAll<HTMLInputElement>('input, textarea, select')].find((el) => !el.checkValidity());
      if (invalido) {
        invalido.setAttribute('aria-invalid', 'true');
        invalido.focus();
        status.textContent = invalido.type === 'email' && invalido.value ? 'Confira o e-mail, parece incompleto.' : 'Preencha os campos obrigatórios.';
        return;
      }

      const dados = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      for (const k of Object.keys(dados)) if (dados[k] === '') delete dados[k];

      botao.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: dados }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('enviado');
        const ok = form.querySelector<HTMLElement>('.form__sucesso')!;
        ok.hidden = false;
        ok.focus();
      } catch {
        status.textContent = 'Não conseguimos enviar agora. Tente de novo em instantes ou escreva para salvistas@salvistas.com.br.';
      } finally {
        botao.disabled = false;
      }
    });
  });
</script>
