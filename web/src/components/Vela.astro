---
// O momento interativo do site: o visitante segura o botão e acende uma vela.
// Ao acender, o texto se revela e leva ao pedido de oração.
---

<section class="vela" data-vela data-vivo aria-labelledby="vela-titulo">
  <div class="wrap vela__grade">
    <div class="vela__cena" aria-hidden="true">
      <div class="vela__halo"></div>
      <svg class="vela__svg" viewBox="0 0 120 260">
        <defs>
          <linearGradient id="cera" x1="0" x2="1">
            <stop offset="0" stop-color="#e9dcc2" /><stop offset=".55" stop-color="#f7efdf" /><stop offset="1" stop-color="#dccdb0" />
          </linearGradient>
          <radialGradient id="chama" cx=".5" cy=".7" r=".6">
            <stop offset="0" stop-color="#fff6d8" /><stop offset=".45" stop-color="#f3c96a" /><stop offset="1" stop-color="#c7542a" stop-opacity=".0" />
          </radialGradient>
        </defs>
        <g class="vela__chama">
          <path d="M60 30c9 16 16 26 16 40a16 16 0 0 1-32 0c0-14 7-24 16-40Z" fill="url(#chama)" />
          <path d="M60 52c4 8 7 13 7 19a7 7 0 0 1-14 0c0-6 3-11 7-19Z" fill="#fffaf0" opacity=".9" />
        </g>
        <line x1="60" y1="84" x2="60" y2="98" stroke="#8a6f62" stroke-width="2.2" stroke-linecap="round" />
        <rect x="38" y="96" width="44" height="150" rx="4" fill="url(#cera)" />
        <path d="M38 104c8 4 14-2 22 2s14 6 22 0" fill="none" stroke="#d9c9a8" stroke-width="1.5" />
      </svg>
    </div>

    <div class="vela__texto">
      <p class="rotulo">Pedido de oração</p>
      <h2 id="vela-titulo">Acenda uma vela pela sua intenção.</h2>
      <p class="vela__antes">Segure o botão por um instante, como quem faz uma prece em silêncio.</p>

      <button class="vela__botao" type="button" data-segurar>
        <svg class="vela__anel" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" /></svg>
        <span class="vela__rotulo-botao">Segure para acender</span>
      </button>

      <div class="vela__depois" data-depois>
        <p>A chama está acesa.</p>
        <p>Deixe seu pedido: ele será lembrado na oração da nossa comunidade.</p>
        <a class="btn btn--carmim" href="/contato#oracao">Escrever meu pedido <span class="seta" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .vela { position: relative; background: var(--noite); color: var(--creme); padding-block: clamp(96px, 12vw, 170px); overflow: hidden; }
  .vela__grade { display: grid; grid-template-columns: 0.8fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .vela__cena { position: relative; display: grid; place-items: center; min-height: 360px; }
  .vela__halo {
    position: absolute; width: 520px; height: 520px; border-radius: 50%; top: 50%; left: 50%; translate: -50% -62%;
    background: radial-gradient(circle, rgba(243, 201, 106, 0.42), rgba(243, 201, 106, 0.08) 45%, transparent 68%);
    opacity: calc(var(--p, 0) * 1);
  }
  .vela__svg { position: relative; width: clamp(130px, 14vw, 170px); height: auto; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.35)); }
  .vela__chama { transform-origin: 60px 84px; transform: scale(calc(0.2 + var(--p, 0) * 0.8)); opacity: var(--p, 0); }
  .vela.acesa.visivel .vela__chama { animation: tremula 3.2s var(--ease-suave) infinite alternate; animation-delay: -1.1s; }
  @keyframes tremula { 0% { transform: scale(1) skewX(0); } 40% { transform: scale(1.03, 0.97) skewX(-2deg); } 100% { transform: scale(0.98, 1.04) skewX(1.5deg); } }

  .vela .rotulo { color: var(--ouro-claro); }
  .vela h2 { margin: 18px 0 20px; max-width: 16ch; }
  .vela__antes { color: rgba(244, 237, 225, 0.78); max-width: 42ch; transition: opacity 600ms var(--ease-saida); }

  .vela__botao {
    position: relative; margin-top: 34px; display: inline-flex; align-items: center; gap: 16px;
    background: none; border: 0; color: var(--creme); font: 500 1rem var(--f-corpo); cursor: pointer; padding: 0;
    user-select: none; -webkit-user-select: none; touch-action: none; -webkit-touch-callout: none;
    transition: opacity 600ms var(--ease-saida);
  }
  .vela__anel { width: 64px; height: 64px; transform: rotate(-90deg); flex: none; }
  .vela__anel circle {
    fill: rgba(244, 237, 225, 0.04); stroke: var(--ouro-claro); stroke-width: 1.5;
    stroke-dasharray: 188.5; stroke-dashoffset: calc(188.5 - 188.5 * var(--p, 0));
    filter: drop-shadow(0 0 6px rgba(216, 189, 133, 0.35));
  }
  .vela__botao::before {
    content: ''; position: absolute; left: 0; top: 0; width: 64px; height: 64px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(244, 237, 225, 0.25);
  }

  .vela__depois { display: grid; gap: 10px; justify-items: start; margin-top: 8px; }
  .vela__depois > * { opacity: 0; transform: translateY(14px); transition: opacity 900ms var(--ease-saida), transform 900ms var(--ease-saida); }
  .vela__depois > :first-child { font-family: var(--f-display); font-style: italic; font-size: 1.7rem; color: var(--ouro-luz); }
  .vela__depois > :nth-child(2) { color: rgba(244, 237, 225, 0.82); max-width: 42ch; }
  .vela__depois > .btn { margin-top: 18px; }
  .vela.acesa .vela__depois > * { opacity: 1; transform: none; }
  .vela.acesa .vela__depois > :nth-child(2) { transition-delay: 250ms; }
  .vela.acesa .vela__depois > :nth-child(3) { transition-delay: 500ms; }
  .vela.acesa .vela__botao, .vela.acesa .vela__antes { opacity: 0; pointer-events: none; }
  .vela.acesa .vela__botao { position: absolute; }
  .vela.acesa .vela__antes { display: none; }
  .vela:not(.acesa) .vela__depois { visibility: hidden; height: 0; overflow: hidden; }

  @media (max-width: 860px) {
    .vela__grade { grid-template-columns: 1fr; text-align: left; }
    .vela__cena { min-height: 260px; }
  }
  @media (max-height: 560px) { .vela__halo { display: none; } }
  @media (pointer: coarse) { .vela__botao { min-height: 64px; } }
</style>

<script>
  const secao = document.querySelector<HTMLElement>('[data-vela]');
  const botao = secao?.querySelector<HTMLButtonElement>('[data-segurar]');

  if (secao && botao) {
    const ENCHER = 1400; // ms segurando para acender
    const ESVAZIAR = 900; // ms para voltar se soltar antes
    let p = 0;
    let segurando = false;
    let ultimo = 0;
    let raf = 0;
    const rotulo = botao.querySelector('.vela__rotulo-botao')!;

    const aplicar = () => secao.style.setProperty('--p', p.toFixed(3));

    const acender = (focar = true) => {
      p = 1;
      aplicar();
      secao.classList.add('acesa');
      rotulo.textContent = 'Vela acesa';
      cancelAnimationFrame(raf);
      raf = 0;
      if (focar) secao.querySelector<HTMLElement>('[data-depois] .btn')?.focus({ preventScroll: true });
    };

    const passo = (t: number) => {
      const dt = ultimo ? t - ultimo : 16;
      ultimo = t;
      p = segurando ? Math.min(1, p + dt / ENCHER) : Math.max(0, p - dt / ESVAZIAR);
      aplicar();
      if (p >= 1) return acender();
      if (!segurando && p <= 0) { raf = 0; return; }
      raf = requestAnimationFrame(passo);
    };

    const inicia = (e: Event) => {
      if (secao.classList.contains('acesa')) return;
      e.preventDefault();
      segurando = true;
      ultimo = 0;
      if (!raf) raf = requestAnimationFrame(passo);
    };
    const solta = () => { segurando = false; };

    botao.addEventListener('pointerdown', inicia);
    addEventListener('pointerup', solta);
    botao.addEventListener('pointerleave', solta);
    botao.addEventListener('pointercancel', solta);
    botao.addEventListener('contextmenu', (e) => e.preventDefault());
    // Teclado: segurar Espaço ou Enter.
    botao.addEventListener('keydown', (e) => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) inicia(e); });
    botao.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') solta(); });

    const rm = matchMedia('(prefers-reduced-motion: reduce)');
    if (rm.matches) acender(false);
    rm.addEventListener('change', (e) => e.matches && acender(false));
  }
</script>
