---
import { mediaUrl, dataLonga, type Post } from '../lib/strapi';

interface Props { post: Post }
const { post } = Astro.props;
const capa = post.capa?.formats?.medium ?? post.capa?.formats?.small ?? post.capa;
---

<article class="card">
  <a href={`/noticias/${post.slug}`}>
    <div class:list={['card__capa', { vazia: !capa }]}>
      {capa ? (
        <img src={mediaUrl(capa)} alt="" width={capa.width ?? undefined} height={capa.height ?? undefined} loading="lazy" decoding="async" />
      ) : (
        <span class="card__sem-capa" aria-hidden="true">
          <svg viewBox="0 0 40 40"><path d="M20 6 34 30H6Z" /><path d="M20 30v6M16 32l4 6 4-6" /></svg>
          <span>{post.categoria?.nome ?? 'Vida salvista'}</span>
        </span>
      )}
    </div>
    <p class="card__meta">
      {post.categoria && <span>{post.categoria.nome}</span>}
      <time datetime={post.data}>{dataLonga(post.data)}</time>
    </p>
    <h3>{post.titulo}</h3>
    {post.resumo && <p class="card__resumo">{post.resumo}</p>}
  </a>
</article>

<style>
  .card a { display: flex; flex-direction: column; gap: 12px; text-decoration: none; height: 100%; }
  .card__capa { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 8px; background: var(--creme-2); margin-bottom: 8px; }
  .card__capa img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-saida); }
  .card a:hover .card__capa img { transform: scale(1.04); }
  .card__capa.vazia {
    display: grid; place-items: center; background:
      radial-gradient(120% 80% at 50% 0%, rgba(216, 189, 133, 0.28), transparent 60%), var(--noite);
    transition: filter 900ms var(--ease-saida);
  }
  .card a:hover .card__capa.vazia { filter: brightness(1.12); }
  .card__sem-capa { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .card__sem-capa svg { width: 44px; fill: none; stroke: var(--ouro-claro); stroke-width: 1; }
  .card__sem-capa span { font-family: var(--f-inscricao); font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ouro-claro); }
  .card__meta { display: flex; gap: 12px; align-items: baseline; font-size: 0.82rem; color: var(--marrom-suave); }
  .card__meta span { font-weight: 600; color: var(--carmim); letter-spacing: 0.02em; }
  .card h3 { font-size: 1.5rem; transition: color 400ms var(--ease-saida); }
  .card a:hover h3 { color: var(--carmim); }
  .card__resumo { font-size: 0.95rem; color: var(--marrom-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
