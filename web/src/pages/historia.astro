---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import selo from '../assets/img/selo-fjs.png';
import brasao from '../assets/img/brasao-imsjs.png';
import peGilberto from '../assets/img/pe-gilberto.webp';

const linha = [
  { ano: '1925', t: 'Nasce Gilberto Maria Defina', d: 'Em 2 de agosto, em Ribeirão Preto (SP), numa família católica.' },
  { ano: '1950', t: 'Ordenação sacerdotal', d: 'Em 3 de dezembro, na Catedral de Ribeirão Preto. Depois, 12 anos como pároco em São Simão.' },
  { ano: '1993', t: 'Nasce a Fraternidade', d: 'Com alguns leigos, Pe. Gilberto funda a Fraternidade, ouvindo jovens que se sentiam “peixes fora d’água” na Igreja.' },
  { ano: '1994', t: 'Os Institutos', d: 'Em 17 de setembro, Seminário e Convento são erigidos por Dom Fernando Antônio Figueiredo, bispo de Santo Amaro. Pe. Gilberto faz os votos perpétuos.' },
  { ano: '2000', t: 'A primeira missão', d: 'A Paróquia Nossa Senhora de Pentecostes e o Centro de Promoção Social Bororé, no Grajaú.' },
  { ano: '2004', t: 'Além de São Paulo', d: 'A missão chega a Dourados (MS). Em 5 de dezembro, o nosso Pai Fundador parte para Deus, aos 79 anos.' },
  { ano: '2005', t: 'Europa', d: 'França (2005), Itália (2006) e Portugal (2007), a convite dos bispos locais.' },
  { ano: '2008', t: 'Fraternidade Jesus Salvador', d: 'Por obediência à Santa Sé, que pediu que não se usasse mais o nome Javé na liturgia, deixamos o nome “Fraternidade Javé Salvador”.' },
  { ano: '2012', t: 'Região Norte', d: 'Primeira missão no Norte do país, na Arquidiocese de Belém do Pará.' },
  { ano: '2026', t: 'V Capítulo Geral', d: 'A família salvista se reúne para rezar, avaliar o caminho e eleger o governo geral para 2026-2031.' },
];
---

<Base title="Nossa história" description="Da inspiração do Pe. Gilberto Maria Defina ao V Capítulo Geral: a história da Fraternidade Jesus Salvador.">
  <Cabecalho rotulo="Quem somos" titulo="Uma obra a serviço do <em>louvor de Deus</em>" lede="Somos religiosos e religiosas, padres e leigos. O nome “salvistas” vem de quem somos: Servos e Servas de Jesus Salvador." />

  <section class="secao linha-tempo">
    <div class="wrap">
      <ol class="tempo" data-tempo>
        {linha.map((l) => (
          <li class="tempo__item" data-revela>
            <span class="tempo__ano">{l.ano}</span>
            <div><h2>{l.t}</h2><p>{l.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao fundador" id="fundador">
    <div class="wrap fundador__grade">
      <div class="revela">
        <p class="rotulo">Nosso Pai Fundador</p>
        <h2>Pe. Gilberto Maria Defina, sjs</h2>
        <p class="fundador__datas">1925 · 2004</p>
        <div class="fundador__foto">
          <Picture src={peGilberto} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(max-width: 860px) 80vw, 440px"
            alt="Pe. Gilberto Maria Defina, fundador da Fraternidade Jesus Salvador, de mãos postas, com casula vermelha." />
        </div>
      </div>
      <div class="fundador__texto revela">
        <p class="lede">Padre por 54 anos, professor, jornalista, pároco e fundador. Formado em Filosofia, Teologia, Letras e Direito.</p>
        <p>
          Aos 12 anos entrou no seminário. Foi professor no Seminário Menor de Ribeirão Preto, diretor do jornal “Diário de Notícias”,
          cônego da Catedral e um dos fundadores das Faculdades Associadas Ipiranga, em São Paulo.
        </p>
        <p>
          Nos últimos anos viveu cinco anos em cadeira de rodas e uma longa enfermidade, sem murmurar. Ensinou que não há humildade
          sem paciência, nem paciência sem humildade.
        </p>
        <blockquote>
          <p>“Se Nosso Senhor o quisesse levar, ele estaria pronto. Se o quisesse deixar aqui, no sofrimento, ele aceitaria com amor.”</p>
          <cite>Pe. Francisco Ivanildo dos Santos, sjs</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="secao simbolos" id="simbolos">
    <div class="wrap">
      <div class="revela simbolos__cabeca">
        <p class="rotulo">Nossos símbolos</p>
        <h2>O que eles dizem</h2>
      </div>
      <div class="simbolos__grade">
        <article class="simbolo revela">
          <Image src={selo} alt="Selo da Fraternidade Jesus Salvador" width={260} />
          <h3>O selo da Fraternidade</h3>
          <p>
            O triângulo vermelho lembra a Santíssima Trindade e o fogo de Pentecostes. Dele desce a pomba do Espírito Santo, com raios de ouro
            sobre as iniciais FJS: tudo o que somos nasce do Espírito.
          </p>
        </article>
        <article class="simbolo revela">
          <Image src={brasao} alt="Brasão do Instituto Missionário Servos de Jesus Salvador" width={220} />
          <h3>O brasão dos Servos</h3>
          <p>
            No escudo carmim com chamas, a pomba do Espírito, o monograma de Maria, a Eucaristia e o livro com Alfa e Ômega.
            A espada e o lírio ladeiam o escudo, e a faixa traz o nosso carisma: <em>Laus Dei</em>, louvor de Deus.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="secao governo" id="governo">
    <div class="wrap governo__caixa revela">
      <p class="rotulo">Governo geral 2026-2031</p>
      <h2>Eleito no V Capítulo Geral</h2>
      <p>Em breve apresentamos aqui o Prior Geral e o conselho eleitos para servir a Fraternidade nos próximos seis anos.</p>
    </div>
  </section>
</Base>

<style>
  .tempo { list-style: none; margin: 0; padding: 0; position: relative; max-width: 900px; margin-inline: auto; }
  .tempo::after {
    content: ''; position: absolute; left: 118px; top: 8px; bottom: 8px; width: 1px;
    background: linear-gradient(var(--ouro), var(--carmim));
    transform-origin: top; transform: scaleY(var(--progresso, 0));
  }
  .tempo::before { content: ''; position: absolute; left: 118px; top: 8px; bottom: 8px; width: 1px; background: var(--linha); }
  .tempo__item { display: grid; grid-template-columns: 96px 1fr; gap: 45px; padding: 0 0 56px; position: relative; }
  .tempo__item::before {
    content: ''; position: absolute; left: 113px; top: 10px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--creme); border: 1px solid var(--ouro); transition: background 600ms var(--ease-saida);
  }
  .tempo__item.in::before { background: var(--ouro); }
  .tempo__ano { font-family: var(--f-display); font-size: 1.9rem; line-height: 1; text-align: right; color: var(--carmim); }
  .tempo__item h2 { font-size: 1.6rem; margin-bottom: 8px; }
  .tempo__item p { color: var(--marrom-2); max-width: 56ch; }
  .tempo__item > * { opacity: 0; transform: translateY(14px); transition: opacity 900ms var(--ease-saida), transform 900ms var(--ease-saida); }
  .tempo__item > :last-child { transition-delay: 120ms; }
  .tempo__item.in > * { opacity: 1; transform: none; }

  .fundador { background: var(--creme-2); }
  .fundador__grade { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(40px, 7vw, 110px); }
  .fundador h2 { margin: 18px 0 12px; max-width: 12ch; }
  .fundador__datas { font-family: var(--f-inscricao); letter-spacing: 0.2em; color: var(--ouro-texto); }
  .fundador__foto { position: relative; margin-top: 40px; max-width: 440px; isolation: isolate; }
  .fundador__foto::after { content: ''; position: absolute; inset: 14px -14px -14px 14px; z-index: -1; border: 1px solid var(--ouro); border-radius: 6px; opacity: 0.7; }
  .fundador__foto :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: 6px; }
  .fundador__grade { align-items: start; }
  .fundador__texto { display: grid; gap: 20px; }
  .fundador__texto p { max-width: 60ch; }
  .fundador blockquote { margin: 16px 0 0; padding-left: 22px; border-left: 2px solid var(--ouro); }
  .fundador blockquote p { font-family: var(--f-display); font-style: italic; font-size: 1.4rem; line-height: 1.45; }
  .fundador cite { display: block; margin-top: 10px; font-style: normal; font-size: 0.85rem; color: var(--marrom-suave); }

  .simbolos__cabeca { margin-bottom: 48px; }
  .simbolos h2 { margin-top: 18px; }
  .simbolos__grade { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .simbolo { border: 1px solid var(--linha); border-radius: 12px; padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .simbolo img { height: 200px; width: auto; margin-bottom: 12px; }
  .simbolo p { color: var(--marrom-2); max-width: 52ch; }

  .governo__caixa { border: 1px dashed var(--linha-forte); border-radius: 12px; padding: clamp(32px, 5vw, 56px); display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .governo__caixa p:last-child { color: var(--marrom-2); max-width: 56ch; }

  @media (max-width: 860px) {
    .fundador__grade, .simbolos__grade { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .tempo::before, .tempo::after { left: 5px; }
    .tempo__item { grid-template-columns: 1fr; gap: 6px; padding-left: 32px; }
    .tempo__item::before { left: 0; }
    .tempo__ano { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .tempo::after { transform: none; } .tempo__item > * { opacity: 1; transform: none; } }
</style>

<script>
  // O fio de ouro da linha do tempo acompanha a rolagem.
  const tempo = document.querySelector<HTMLElement>('[data-tempo]');
  if (tempo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let alvo = 0;
    let atual = 0;
    let raf = 0;
    const medir = () => {
      const r = tempo.getBoundingClientRect();
      alvo = Math.min(1, Math.max(0, (innerHeight * 0.7 - r.top) / r.height));
      if (!raf) raf = requestAnimationFrame(passo);
    };
    const passo = () => {
      atual += (alvo - atual) * 0.12;
      if (Math.abs(alvo - atual) < 0.001) atual = alvo;
      tempo.style.setProperty('--progresso', atual.toFixed(4));
      raf = atual === alvo ? 0 : requestAnimationFrame(passo);
    };
    addEventListener('scroll', medir, { passive: true });
    addEventListener('resize', medir);
    medir();
  }
</script>
