---
import Base from '../../../layouts/Base.astro';
import Cabecalho from '../../../components/Cabecalho.astro';
import ListaNoticias from '../../../components/ListaNoticias.astro';
import { getCategoria, getCategorias, getPostsDaCategoria } from '../../../lib/strapi';

const slug = Astro.params.slug ?? '';
const categoria = await getCategoria(slug);
if (!categoria) return Astro.rewrite('/404');
const [categorias, posts] = await Promise.all([getCategorias(), getPostsDaCategoria(slug)]);
---

<Base title={categoria.nome} description={categoria.descricao ?? undefined}>
  <Cabecalho rotulo="Notícias" titulo={categoria.nome} lede={categoria.descricao ?? undefined} />
  <ListaNoticias posts={posts} categorias={categorias} ativa={categoria.slug} />
</Base>
