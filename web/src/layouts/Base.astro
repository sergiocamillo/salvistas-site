---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  headerClaro?: boolean;
}

const {
  title,
  description = 'Padres, irmãos, irmãs e leigos que vivem para o louvor de Deus e levam a salvação de Jesus a quem mais precisa.',
  image = '/og.jpg',
  headerClaro = false,
} = Astro.props;

const fullTitle = title ? `${title} · Fraternidade Jesus Salvador` : 'Fraternidade Jesus Salvador · Salvistas';
const site = Astro.site ?? new URL('https://salvistas.com.br');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4ede1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <!-- DEPLOY STEP: og:url e og:image dependem do domínio final (Astro.site em astro.config.mjs) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site)} />
    <meta property="og:image" content={new URL(image, site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Figtree:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Pular para o conteúdo</a>
    <div class="ambiente" aria-hidden="true"></div>
    <Header claro={headerClaro} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Entradas: .revela ganha .in ao entrar na tela e .pronto quando a coreografia termina.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.classList.add('in');
            io.unobserve(el);
            setTimeout(() => el.classList.add('pronto'), 1500);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('.revela, .fio, [data-revela]').forEach((el) => io.observe(el));

      // Elementos vivos só animam quando visíveis.
      const vivo = new IntersectionObserver((entries) => {
        for (const e of entries) e.target.classList.toggle('visivel', e.isIntersecting);
      });
      document.querySelectorAll('[data-vivo]').forEach((el) => vivo.observe(el));

      // Aba escondida: pausa tudo.
      document.addEventListener('visibilitychange', () => document.body.classList.toggle('pausado', document.hidden));

      // Movimento reduzido ligado com a página aberta: tudo vai para o estado final.
      const rm = matchMedia('(prefers-reduced-motion: reduce)');
      const fixar = () => document.querySelectorAll('.revela, .fio, [data-revela]').forEach((el) => el.classList.add('in', 'pronto'));
      if (rm.matches) fixar();
      rm.addEventListener('change', (e) => e.matches && fixar());
    </script>
  </body>
</html>
