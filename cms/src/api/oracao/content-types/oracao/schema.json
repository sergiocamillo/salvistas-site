{
  "kind": "collectionType",
  "collectionName": "oracoes",
  "info": {
    "singularName": "oracao",
    "pluralName": "oracoes",
    "displayName": "Oração",
    "description": "Orações próprias da Fraternidade"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "intencao": {
      "type": "string"
    },
    "introducao": {
      "type": "text"
    },
    "texto": {
      "type": "blocks",
      "required": true
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ordem": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}