{
  "kind": "collectionType",
  "collectionName": "santos",
  "info": {
    "singularName": "santo",
    "pluralName": "santos",
    "displayName": "Santo",
    "description": "Patronos e baluartes salvistas"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "patrono",
        "baluarte"
      ],
      "default": "patrono",
      "required": true
    },
    "festa": {
      "type": "string"
    },
    "descricao": {
      "type": "text"
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "ordem": {
      "type": "integer",
      "default": 0
    }
  }
}